# 复制为 .env。此文件只由服务端读取。
#
# 两种使用方式，任选其一：
#   1) 应用内 BYOK：在 App 的「模型与密钥」里填入自己的 API Key。
#      服务端密钥可以留空，应用会随请求把 Key 发到本服务端再转发给模型。
#   2) 服务端统一密钥：在下面填写 DEEPSEEK_API_KEY 或 OPENROUTER_API_KEY，
#      所有登录账号共用；应用内填写的 Key 会覆盖这里的默认值。
#
# 切勿把 Key 写入前端代码、VITE_ 变量、APK 或提交到仓库。
# NODE_ENV=production

# DeepSeek 官方 API（默认服务商）
DEEPSEEK_API_KEY=
CHAT_PROVIDER=deepseek
# 可覆盖模型名，例如 deepseek-chat / deepseek-reasoner。留空使用 deepseek-flash。
# CHAT_MODEL=

# OpenRouter（可选）。把 CHAT_PROVIDER 改为 openrouter 即用此通道。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# off 速度最快；low 保留少量思考；留空使用模型默认。
OPENROUTER_REASONING=off
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_FREE_ENABLED=false

# 服务监听。npm run dev 固定用 127.0.0.1:8787。
HOST=127.0.0.1
PORT=8787

# 数据目录默认是项目 data/。服务端只保存账号、会话元数据和用量；
# 安卓端的聊天正文按账号加密保存在手机本机。
# DATA_DIR=./data

MAX_OUTPUT_TOKENS=4096
MAX_CONTEXT_CHARS=180000
ALLOW_REGISTRATION=true

# 正式 HTTPS 部署请设为 true（直接 HTTPS 或可信反向代理）。
COOKIE_SECURE=false

# 通常无需修改。同源请求自动通过；额外开发来源用逗号分隔。
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 原生安装包本地页面的精确来源，禁止使用 *。
NATIVE_ALLOWED_ORIGINS=https://localhost
NATIVE_SESSION_TTL_SECONDS=86400

# 并发与运行元数据保留天数。
SERVER_MAX_CONCURRENT=4
METADATA_RETENTION_DAYS=90

# 网页端是否保留旧版服务端聊天历史。安卓 App 始终使用本机加密记录。
ENABLE_LEGACY_HISTORY=false
